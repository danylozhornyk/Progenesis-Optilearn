# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://progenesis:progenesis_secret@localhost:5432/progenesis_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ──────────────────────────────────────────
RABBITMQ_URL=amqp://progenesis:rabbitmq_secret@localhost:5672

# ── AI API ────────────────────────────────────────────
AI_API_KEY=your_api_key_here
AI_API_URL=https://api.anthropic.com

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# ── Storage ───────────────────────────────────────────
# STORAGE_PROVIDER=local   ← default (dev, files saved to apps/backend/uploads/)
# STORAGE_PROVIDER=s3      ← production / MinIO

STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=s3:
# S3_ENDPOINT=http://localhost:9000   # omit for AWS S3; keep for MinIO / Cloudflare R2
# S3_REGION=us-east-1
# S3_BUCKET=optilearn
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000 # base URL browsers use to load images

# MinIO console credentials (Docker only)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ── Monitoring ────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=grafana_secret
