generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
  GUEST
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  HIDDEN
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TaskType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  OPEN_ANSWER
}

enum GraphType {
  DIRECTED
  UNDIRECTED
  WEIGHTED
  MIXED
}

enum AchievementCategory {
  PROGRESS
  SKILL
  STREAK
  SOCIAL
}

enum SubmissionStatus {
  PENDING
  GRADED
}

// ─── Models ──────────────────────────────────────────────────────

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String         @unique @db.VarChar(254)
  passwordHash    String         @db.VarChar(72)
  role            UserRole       @default(STUDENT)
  fullName        String         @db.VarChar(200)
  isEmailVerified Boolean        @default(false)
  avatarUrl       String?        @db.VarChar(500)
  /// UI settings e.g. {"locale":"uk","theme":"dark","notifications":{"email":true,"push":false}}
  preferences     Json           @default("{}")
  createdAt       DateTime       @default(now()) @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @db.Timestamptz()

  courses         Course[]
  graphs          Graph[]
  progress        UserProgress[]
  achievements    Achievement[]
  testSubmissions TestSubmission[]
  aiRecommendations AiRecommendation[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Course {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String          @db.Uuid
  title         String          @db.VarChar(200)
  titleUk       String?         @db.VarChar(200)
  description   String
  descriptionUk String?
  discipline    String          @db.VarChar(100)
  disciplineUk  String?         @db.VarChar(100)
  difficulty    DifficultyLevel
  status        CourseStatus    @default(DRAFT)
  coverImageUrl String?         @db.VarChar(500)
  isVisible     Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.Timestamptz()
  updatedAt     DateTime        @updatedAt @db.Timestamptz()

  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  progress      UserProgress[]

  @@index([authorId])
  @@index([discipline, difficulty])
  @@index([status])
  @@map("courses")
}

model Lesson {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId         String    @db.Uuid
  prerequisiteId   String?   @db.Uuid
  title            String    @db.VarChar(200)
  titleUk          String?   @db.VarChar(200)
  orderIndex       Int
  /// Array of content blocks e.g. [{type:"text",value:"..."},{type:"latex",value:"..."}]
  content          Json      @default("[]")
  /// Ukrainian-translated content blocks; same shape as content
  contentUk        Json?
  estimatedMinutes Int?
  isMandatory      Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz()

  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Lesson?   @relation("LessonPrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  dependents   Lesson[]  @relation("LessonPrerequisite")
  tests        Test[]

  @@index([courseId, orderIndex])
  @@index([prerequisiteId])
  @@map("lessons")
}

model Test {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId         String    @db.Uuid
  title            String    @db.VarChar(200)
  titleUk          String?   @db.VarChar(200)
  description      String?
  descriptionUk    String?
  /// NULL = no time limit
  timeLimitMin     Int?
  /// NULL = unlimited attempts
  maxAttempts      Int?
  /// Minimum % needed to pass
  passingScore     Decimal   @default(60.0) @db.Decimal(5, 2)
  shuffleQuestions Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz()

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tasks       Task[]
  submissions TestSubmission[]

  @@index([lessonId])
  @@map("tests")
}

model Task {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  testId          String   @db.Uuid
  graphId         String?  @db.Uuid
  taskType        TaskType
  orderIndex      Int
  statement       String
  statementUk     String?
  options         Json?
  /// Ukrainian-translated options; same shape as options
  optionsUk       Json?
  correctAnswer   String
  answerTolerance Decimal? @db.Decimal(20, 18)
  maxScore        Decimal  @default(1.0) @db.Decimal(5, 2)
  explanation     String?
  explanationUk   String?
  /// [{strength:0-100, text:"..."}] — higher strength = more explicit hint; served based on user progress
  hints           Json     @default("[]")
  /// Ukrainian-translated hints; same shape as hints
  hintsUk         Json?
  createdAt       DateTime @default(now()) @db.Timestamptz()

  test  Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  graph Graph? @relation(fields: [graphId], references: [id], onDelete: SetNull)

  @@index([testId, orderIndex])
  @@index([taskType])
  @@index([graphId])
  @@map("tasks")
}

model Graph {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL for system/template graphs
  userId      String?   @db.Uuid
  title       String?   @db.VarChar(200)
  titleUk     String?   @db.VarChar(200)
  graphType   GraphType
  /// [{id,label,x,y,color}]
  vertices    Json      @default("[]")
  /// [{source,target,weight,label}]
  edges       Json      @default("[]")
  vertexCount Int       @default(0)
  edgeCount   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([userId])
  @@index([graphType])
  @@map("graphs")
}

model UserProgress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  courseId        String   @db.Uuid
  /// Percentage of course completed (0-100)
  progressPercent Decimal  @default(0) @db.Decimal(5, 2)
  /// Accumulated score across all tasks in this course
  totalScore      Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("user_progress")
}

model Achievement {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @db.Uuid
  code          String              @db.VarChar(50)
  name          String              @db.VarChar(100)
  nameUk        String?             @db.VarChar(100)
  description   String
  descriptionUk String?
  category      AchievementCategory
  iconUrl       String?             @db.VarChar(500)
  pointsAwarded Int                 @default(0)
  awardedAt     DateTime            @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@index([category])
  @@map("achievements")
}

model TestSubmission {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String           @db.Uuid
  testId        String           @db.Uuid
  attemptNumber Int              @default(1)
  status        SubmissionStatus @default(PENDING)
  totalScore    Decimal          @default(0) @db.Decimal(5, 2)
  maxScore      Decimal          @default(0) @db.Decimal(5, 2)
  percentScore  Decimal          @default(0) @db.Decimal(5, 2)
  passed        Boolean          @default(false)
  timeSpentMs   Int?
  /// [{ taskId, userAnswer, isCorrect, score }]
  answers       Json             @default("[]")
  submittedAt   DateTime         @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId, testId])
  @@index([testId])
  @@index([submittedAt])
  @@map("test_submissions")
}

model AiRecommendation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  analysis    Json     // full AI response stored as JSONB
  createdAt   DateTime @default(now()) @db.Timestamptz()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_recommendations")
}

model EmailVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz()
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}
